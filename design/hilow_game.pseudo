# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

START hilow_game

    # Establish a valid guessing range.
    OUTPUT "Enter the lower bound: "
    INPUT lower_bound

    OUTPUT "Enter the upper bound: "
    INPUT upper_bound

    WHILE lower_bound >= upper_bound DO
        OUTPUT "Invalid input. The lower bound must be less than the upper bound."
        OUTPUT "Enter the lower bound: "
        INPUT lower_bound
        OUTPUT "Enter the upper bound: "
        INPUT upper_bound
    ENDWHILE

    # Establish the number the player is trying to guess.
    secret_number = GENERATE_RANDOM_NUMBER(lower_bound, upper_bound)

    # Play the game.
    guess = -1

    WHILE guess != secret_number DO
        OUTPUT "Enter your guess between ", lower_bound, " and ", upper_bound, ": "
        INPUT guess

        WHILE guess < lower_bound OR guess > upper_bound DO
            OUTPUT "Invalid guess. Please enter a value between ", lower_bound, " and ", upper_bound, ": "
            INPUT guess
        ENDWHILE

        IF guess < secret_number THEN
            OUTPUT "Your guess is too low. Try again!"
        ELSE IF guess > secret_number THEN
            OUTPUT "Your guess is too high. Try again!"
        ELSE
            OUTPUT "Congratulations! You guessed the right number!"
        ENDIF

    ENDWHILE

END hilow_game
 
